{
  "name": "codeharborx-desktop-agent",
  "version": "0.4.1",
  "description": "CodeHarborX — standalone local desktop command center for projects, NAS backups, local AI, MCP, packaging, and GitHub-powered updates.",
  "main": "src/main.js",
  "author": "CodeHarborX",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "npm run prepare:icon && electron-builder --win nsis --publish never",
    "release:win": "npm run prepare:icon && electron-builder --win nsis --publish always",
    "prepare:icon": "node scripts/generate-icon.js"
  },
  "devDependencies": {
    "electron": "38.2.1",
    "electron-builder": "26.0.12",
    "sharp": "0.34.4"
  },
  "build": {
    "appId": "com.codeharborx.agent",
    "productName": "CodeHarborX",
    "artifactName": "CodeHarborX-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/icon.svg",
      "scripts/generate-icon.js",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CodeHarborX"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bobby1187",
        "repo": "codeharborx-desktop-agent",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bobby1187/codeharborx-desktop-agent.git"
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  }
}
