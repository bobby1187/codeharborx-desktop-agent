{
  "name": "codeharborx-desktop-agent",
  "version": "0.6.1",
  "description": "CodeHarborX — standalone desktop command center with local Builder, NAS backups, Ollama AI, MCP, packaging, and GitHub-powered updates.",
  "main": "src/main.js",
  "author": "CodeHarborX",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:tunnel-host": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/build-tunnel-host.ps1",
    "predist:win": "npm run build:tunnel-host",
    "prerelease:win": "npm run build:tunnel-host",
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --publish never",
    "release:win": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "38.2.1",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.codeharborx.agent",
    "productName": "CodeHarborX",
    "artifactName": "CodeHarborX-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/logo.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/tunnel-host.exe",
        "to": "tunnel-host.exe"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CodeHarborX"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bobby1187",
        "repo": "codeharborx-desktop-agent",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bobby1187/codeharborx-desktop-agent.git"
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  }
}
